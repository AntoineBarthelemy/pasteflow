{
  "manifest_version": 3,
  "name": "PasteFlow",
  "version": "1.1.0",
  "description": "Laisse PasteFlow lire les onglets récents quand tu appuies sur son raccourci. Rien n'est lu en continu, rien ne quitte ton ordinateur.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": ["nativeMessaging", "tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  }
}
