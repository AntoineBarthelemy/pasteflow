<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows application: notification area icon and global shortcut; Windows 10 2004 or later for the OCR of Windows -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only used for the notification area icon (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Required by the LibraryImport source generator -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Avoid ambiguities between WPF and Windows Forms types (Application, MessageBox, ...) -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PasteFlow.Core\PasteFlow.Core.csproj" />
  </ItemGroup>

  <!-- Installation per user, without administrator rights, and automatic updates -->
  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PasteFlow.App.Tests" />
  </ItemGroup>

</Project>
